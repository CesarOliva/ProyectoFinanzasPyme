# Copia este archivo como .env y ajusta los valores. Nunca subas .env al repositorio.

# MySQL local:  mysql+pymysql://USUARIO:CONTRASEÑA@HOST:PUERTO/BASE?charset=utf8mb4
DATABASE_URL=mysql+pymysql://root:TU_CONTRASEÑA@localhost:3306/cuentas_claras?charset=utf8mb4

# Genera uno con:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_EXPIRA_HORAS=12

# IA local con Ollama (ollama pull llama3.2:3b)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODELO=llama3.2:3b
OLLAMA_TIMEOUT=120

# Orígenes del frontend permitidos (JSON)
CORS_ORIGENES=["http://localhost:5173","http://127.0.0.1:5173"]
MAX_ARCHIVO_MB=5
